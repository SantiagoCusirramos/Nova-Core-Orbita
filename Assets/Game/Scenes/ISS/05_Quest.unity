  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83c823a459c1b47dfb15afcd3915d190, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StationTelemetry
  missions:
  - {fileID: 11400000, guid: 4cafac4bc568e744185546a54a250900, type: 2}
  - {fileID: 11400000, guid: ef3fe57df97a951459b6e6891db7faa3, type: 2}
  totalSeconds: 1800
  startEnergy: 0.15
  messagesByObjective:
  - objectiveId: energy_01
    text: "Eva, aqu\xED Control. Falla en la distribuci\xF3n el\xE9ctrica. Activa el protocolo de emergencia en el Nodo."
  - objectiveId: energy_02
    text: "Protocolo activo. El m\xF3dulo energ\xE9tico de repuesto est\xE1 en Destiny."
  - objectiveId: energy_03
    text: "M\xF3dulo en tu bolsa. Ll\xE9valo a la compuerta de mantenimiento de Zvezda."
  - objectiveId: energy_04
    text: "Repuesto recibido. Activa la consola de control rob\xF3tico."
  - objectiveId: energy_05
    text: "Consola lista. Sustituye el m\xF3dulo averiado con el brazo rob\xF3tico."
  - objectiveId: energy_06
    text: "Instalaci\xF3n detectada. Confirma el diagn\xF3stico de reparaci\xF3n."
  - objectiveId: solar_01
    text: "Nueva alerta: da\xF1o en el panel solar. Ve a la esclusa Quest y equ\xEDpate el traje."
  - objectiveId: solar_04
    text: Traje verificado. Despresuriza la esclusa.
  - objectiveId: solar_05
    text: "Activa la mochila de propulsi\xF3n. Fuera usar\xE1s los propulsores: A sube, B baja."
  - objectiveId: solar_06
    text: "Escotilla abierta. Vuela hasta el panel da\xF1ado siguiendo las flechas."
  - objectiveId: solar_07
    text: "Est\xE1s junto al panel. Procede con la reparaci\xF3n."
  - objectiveId: solar_08
    text: Panel reparado. Regresa a la esclusa.
  - objectiveId: solar_10
    text: "Confirma desde la C\xFApula que la energ\xEDa qued\xF3 estabilizada."
  historySize: 3
